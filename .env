# ==============================================================================
# Lumi Companion - Whisper / 音声認識設定
# 優先順位: OS環境変数 > .env > config.pyデフォルト値
# ==============================================================================

# モデルサイズ (base / small / medium / large-v3-turbo / large-v3)
WHISPER_MODEL_SIZE=large-v3

# 実行デバイス (auto / cuda / cpu)
WHISPER_DEVICE=auto

# 計算精度 / 量子化 (default / float16 / int8 / float32)
WHISPER_COMPUTE_TYPE=default

# 認識言語
WHISPER_LANGUAGE=ja

# ビームサーチ幅
WHISPER_BEAM_SIZE=5

# 初期誘導プロンプト (独り言・口語表現の実例文)
WHISPER_INITIAL_PROMPT="
こんにちは。
以下は普通の独り言や口語体の音声です。
簡単そうなヤツで、行きますか。レイトンに居るじゃん！
おはようござい。ますあっという間に相談しちゃって死んじゃうじゃん。
え？有効範囲外！ダメだよ、テント貼っとかなんきゃぁ⋯
マチィーンを拾いに行かないと。いつも季節おんなじなんすよね。楽しく遊べれば。
どうだ？
はい、みなさんこんにちは。じいちゃんこと萌えスイッチでーす。
チャットのね、あの、読み上げのツールをちょっと、入れてみたので、
えー、ま、そのテスト兼ねて、
いつもの感じで、配信していきたいなーと思ってまーす。
よろしくお願いしまーす。
はい、まずは、まずご飯。まずご飯ー♪
はい。あれ、何処いった？何処いった、え？何処いった？
だめだろ、ちょっとぉ、じ、じっとしてなさいアンタ、オヤツあげんだからさぁ。
ほら、はい。食べて食べて。はい、いい子いい子。
はい。
で、えーと、今日もあの、あれでね？えー、デイリーチャレンジ。
デイリーチャンレジを、ちょっとやってこうかなーと、思います。
チャレンジ！えー。じゃ、今日のディリーは。
えー、まずは。撮影、ブタ、キツネ、
キツネの撮影はきっついんじゃないのぉ？いけるかなぁ？
ヒツジ、弓またはクロスボウ。ヒツジ。
ヒツジってやったことないね？
弓またはクロスボウ、ヒット心臓はちょと難しいね。
狩る。弓またはクロスボウ、レイトン、あ、これいいね！
レイトン、いつものやつだね。狩猟基準を満たす⋯ガン。
ガン。ガンねぇ。
キツネ、ブタさん。夜の撮影はきついだろぉ。
まぁ、ちょっと。この辺の、簡単そうなヤツで行きますか。はい！
あ、ウィークリーは？ウィークリィ、あ、ここもヒツジが居るよ！
鳥。狩猟基準を満たす。弓またはクロスボウ。
13。13。
弓またはクロスボウって、ちっ、まぁ、いいか。まやってみましょう、はい。
ちょっと難しいかもしれない。
はいじゃ、まずは。えー、まずは普通に、鳥でいきますか。
鳥、弓またはクロス⋯、弓またはクロスボウだからなぁ、まぁいいか⋯はい。
じゃぁすでね、あー、レイトン、レイトンに飛んで、
今どこにいんだっけ？レイトンに居るじゃん！いいよぉ〜？
レイトンて、テイトンて、ガン飛んでくるんだっけ？まあいいか。
えちょっと、じゃぁ、あの。
なんだっけ、あそう、うんと、あちょっと夜、夜だからぁ、朝にしましょう。
朝にしてっと。えー、どんぐらいあればいいかな？7時くらい？7時くらい。
はい！おはようございます！
ね、はい。
だいじょぶ？お腹空いてない？あ、お腹すいてる。はぃ。
よしよしよしよしよし。
まずは、ガン飛んでくんのかな？
ヒルシュフェルデンはなんか確かカナダガンが来たような気がしないでもない。
レイトンで飛んで来たかどうかは、ちょっと良くわかってない。
234じゃムース無理だもんな。
クォータ使用量は、わからないのだ。
クォータ使用量は、41ユニットです。
萌スイッチでした。さようなら。
"

# 直前文脈への依存 (True / False) - 小さい声での同一語句ループ(ハルシネーション)防止のため False 推奨
WHISPER_CONDITION_ON_PREVIOUS_TEXT=False

# VAD (音声アクティビティ検出) フィルタ有効化 (True / False)
WHISPER_VAD_FILTER=True

# VAD 検出閾値 (0.0〜1.0) - 小さな独り言を拾うため 0.35 に緩和 (デフォルト: 0.5)
WHISPER_VAD_THRESHOLD=0.35

# VAD 最小無音時間(ミリ秒)
WHISPER_VAD_MIN_SILENCE_DURATION_MS=500

# 無音判定閾値 (0.0〜1.0)
WHISPER_NO_SPEECH_THRESHOLD=0.5
