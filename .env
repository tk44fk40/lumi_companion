# ==============================================================================
# Lumi Companion - Whisper / 音声認識設定
# 優先順位: OS環境変数 > .env > config.pyデフォルト値
# ==============================================================================

# モデルサイズ (base / small / medium / large-v3-turbo / large-v3)
WHISPER_MODEL_SIZE=large-v3-turbo

# 実行デバイス (auto / cuda / cpu)
WHISPER_DEVICE=auto

# 計算精度 / 量子化 (default / float16 / int8 / float32)
WHISPER_COMPUTE_TYPE=default

# 認識言語
WHISPER_LANGUAGE=ja

# ビームサーチ幅
WHISPER_BEAM_SIZE=5

# 初期誘導プロンプト (独り言・口語表現の実例文)
WHISPER_INITIAL_PROMPT="えーっと、そうだな。今日は何をしようかな。とりあえずこれを試してみるか……よし、これでいこう。"

# 直前文脈への依存 (True / False) - 小さい声での同一語句ループ(ハルシネーション)防止のため False 推奨
WHISPER_CONDITION_ON_PREVIOUS_TEXT=False

# VAD (音声アクティビティ検出) フィルタ有効化 (True / False)
WHISPER_VAD_FILTER=True

# VAD 検出閾値 (0.0〜1.0) - 小さな独り言を拾うため 0.35 に緩和 (デフォルト: 0.5)
WHISPER_VAD_THRESHOLD=0.35

# VAD 最小無音時間(ミリ秒)
WHISPER_VAD_MIN_SILENCE_DURATION_MS=500

# 無音判定閾値 (0.0〜1.0)
WHISPER_NO_SPEECH_THRESHOLD=0.6
