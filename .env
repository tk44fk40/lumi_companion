# ==============================================================================
# Lumi Companion - Whisper / 音声認識設定
# 優先順位: OS環境変数 > .env > config.pyデフォルト値
# ==============================================================================

# モデルサイズ (base / small / medium / large-v3-turbo / large-v3)
WHISPER_MODEL_SIZE=large-v3-turbo

# 実行デバイス (auto / cuda / cpu)
WHISPER_DEVICE=auto

# 計算精度 / 量子化 (default / float16 / int8 / float32)
WHISPER_COMPUTE_TYPE=float16

# 認識言語
WHISPER_LANGUAGE=ja

# ビームサーチ幅(くつの候補を同時に考えながら予測を進めるか デフォルト 5)
WHISPER_BEAM_SIZE=2

# 初期誘導プロンプト (雑談・ゲーム実況向けスタイル指示)
WHISPER_INITIAL_PROMPT="日本語のゲーム実況・雑談配信です。ボソボソ声、独り言、話し言葉を正確に文字起こしします。"

# 直前文脈への依存 (True / False) - 小さい声での同一語句ループ(ハルシネーション)防止のため False 推奨
WHISPER_CONDITION_ON_PREVIOUS_TEXT=True

# VAD (音声アクティビティ検出) フィルタ有効化 (True / False)
WHISPER_VAD_FILTER=True

# VAD 検出閾値 (0.0〜1.0) - 小さな独り言を拾うために緩和 (デフォルト: 0.5)
# 0.34未満にすると、ノイズを拾って単語発言位置がズレることが多くなる
WHISPER_VAD_THRESHOLD=0.4

# VAD 最小無音時間(ミリ秒)
WHISPER_VAD_MIN_SILENCE_DURATION_MS=250

# 無音判定閾値 (0.0〜1.0) - (デフォルト: 0.6)
# 値を下げる（例: 0.4 〜 0.5）: 無音判定を厳しくします。BGM や環境ノイズによって無音部分に意味不明な文字が捏造されるのを強力に防ぎたい場合に有効です。
# 値を上げる（例: 0.7 〜 0.8）: 無音判定を緩めます。ボソボソ声や小さな独り言が「無音」と誤判定されて切り落とされるのを防ぎたい場合に有効です。
# 0.7 未満だと誤認識や欠落する箇所が多くなる
WHISPER_NO_SPEECH_THRESHOLD=0.85

# 長大セグメントの文字数による自動分割（0 で機能OFF）
WHISPER_MAX_SEGMENT_CHARS=30


# ==============================================================================
# テキスト後処理設定
# ==============================================================================

# テキスト後処理: 全角英数字を半角に統一するか
WHISPER_POST_PROCESS_TO_HANKAKU=False

# テキスト後処理: 漢数字等をアラビア数字に正規化するか
WHISPER_POST_PROCESS_NORMALIZE_NUMS=True

# テキスト後処理: 英字を小文字化するか
WHISPER_POST_PROCESS_LOWER=False

# テキスト後処理: 句読点等の記号を削除するか
WHISPER_POST_PROCESS_REMOVE_PUNCT=False


# ==============================================================================
# Ollama / LLM 設定
# ==============================================================================

# Ollama サーバーホスト
OLLAMA_HOST=http://localhost:11434

# 視覚対応モデル (qwen2.5vl:3b, thatdamai/qwen3-vl:2b, llava, moondream 等)
OLLAMA_MODEL=qwen2.5vl:3b

# コンテキストサイズ (画像+プロンプトを処理できる十分なサイズ)
OLLAMA_NUM_CTX=8192

# 推論時の最大出力トークン数 (長文や解説の暴走を防ぐハードリミット)
OLLAMA_NUM_PREDICT=40

# サンプリング温度 (低いほど安定して短い応答になる。デフォルト: 0.4)
OLLAMA_TEMPERATURE=0.4

# プロンプトに含める直近字幕の最大文字数 (ノイズ軽減のため 500 に制限)
PROMPT_MAX_SUBTITLE_CHARS=500


# ==============================================================================
# パス設定
# ==============================================================================

# デフォルトの入力動画パス
DEFAULT_VIDEO_PATH=data/test_videos/sample.mp4

# デバッグ用出力ディレクトリ
DEBUG_OUTPUT_DIR=debug_output

# カスタム辞書（表記揺れ・ユーザー指定用語）のパス
CUSTOM_DICTIONARY_PATH=data/custom_dictionary.yaml

# ==============================================================================
# 字幕表示タイミング調整設定
# ==============================================================================

# 発話終了後の余韻表示秒数 (発声終了後に字幕を残す時間)
SUBTITLE_END_PADDING=1.0

# 字幕の最小表示秒数 (短い発言でも読み取れる最低時間)
SUBTITLE_MIN_DURATION=1.5

# 連続する字幕セグメント間の最小隙間秒数 (次セグメントとの重複防止)
SUBTITLE_MIN_GAP=0.05
